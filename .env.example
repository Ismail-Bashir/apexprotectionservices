# Copy to .env.local for local development. In production these are set by
# .github/workflows/deploy.yml.

# Web3Forms access key for the inbox that receives quote requests and job
# applications. In GitHub, store it as the repository secret WEB3FORMS_KEY.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Live site URL and base path. The deploy workflow fills these in from GitHub Pages.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_PATH=
